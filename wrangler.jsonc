{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BACKEND_URL": "https://api.accounts.sandagakuen.ed.jp",
    "FRONTEND_URL": "https://accounts.sandagakuen.ed.jp",
    "COOKIE_DOMAIN": ""
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accounts",
      "database_id": "c0ffed68-d992-4346-a622-27213484e541",
      "remote": true
    }
  ],
  // "ai": {
  //   "binding": "AI"
